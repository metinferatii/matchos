# Copy to agents/.env. RELAY_* values are created automatically on first run.
OPENAI_API_KEY=
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Newsroom upgrades (default on; set to 0 to fall back to the original pipeline instantly)
PRODUCER=1
HIRING=1
NEGOTIATION=1
INITIATIVE=1
# Optional: OPENAI_MODEL (commentary, translation) and OPENAI_FAST_MODEL (producer decisions, default gpt-4o-mini)
